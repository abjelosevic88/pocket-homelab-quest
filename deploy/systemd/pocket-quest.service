[Unit]
Description=Pocket Quest — tabletop role-playing games (5E)
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-quest
Group=pocket-quest
ExecStart=/usr/local/bin/pocket-quest
Environment=DATA_DIR=/var/lib/pocket-quest
Environment=PORT=8080
Environment=BASE_URL=https://quest.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-quest
PrivateTmp=true

[Install]
WantedBy=multi-user.target
